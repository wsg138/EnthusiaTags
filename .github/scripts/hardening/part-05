        return new DailyInventoryHolder(false, claimSlot, MENU_SESSION, 27, title);
    }

    static DailyInventoryHolder animation(UUID sessionId, Component title) {
        return new DailyInventoryHolder(true, -1, sessionId, 27, title);
    }

